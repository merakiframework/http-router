# Normalize all text files to LF in the repo and in the working copy.
# This overrides core.autocrlf for everyone who clones the project.
* text=auto eol=lf

# PHP source and config files
*.php     text diff=php eol=lf
*.json    text eol=lf
*.xml     text eol=lf
*.yaml    text eol=lf
*.yml     text eol=lf
*.lock    text -diff eol=lf
*.md      text diff=markdown eol=lf
*.txt     text eol=lf
*.sh      text eol=lf
*.ini     text eol=lf
*.dist    text eol=lf
*.neon    text eol=lf

# Windows-only files must keep CRLF
*.bat     text eol=crlf
*.cmd     text eol=crlf
*.ps1     text eol=crlf

# Binary files — never touch line endings
*.png     binary
*.jpg     binary
*.jpeg    binary
*.gif     binary
*.ico     binary
*.svg     text eol=lf
*.ttf     binary
*.woff    binary
*.woff2   binary
*.zip     binary
*.gz      binary
*.tar     binary
*.7z      binary
*.pdf     binary

# Patch files — preserve as-is
*.patch   -text

# Export excludes
.gitattributes export-ignore
.gitignore     export-ignore
.github/       export-ignore
