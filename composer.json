{
    "name": "meraki/http-router",
    "description": "Maps HTTP requests to HTTP responses in PHP 8+.",
    "type": "library",
    "require": {
        "php": "^8.4",
        "doctrine/inflector": "^2.1",
        "willdurand/negotiation": "^3.1",
        "psr/log": "^3.0"
    },
    "require-dev": {
        "laminas/laminas-diactoros": "^3.8",
        "marcocesarato/php-conventional-changelog": "^1.17",
        "vimeo/psalm": "^7.x-dev",
        "psalm/plugin-phpunit": "^0.20",
        "phpunit/phpunit": "^13.1",
        "friendsofphp/php-cs-fixer": "^3.95",
        "spatie/phpunit-watcher": "^1.24",
        "captainhook/captainhook": "^5.29",
        "ramsey/conventional-commits": "^1.7",
        "laminas/laminas-httphandlerrunner": "^2.13"
    },
    "license": "MIT",
    "authors": [
        {
            "name": "Nathan Bishop",
            "email": "nbish11@hotmail.com"
        }
    ],
    "autoload": {
        "psr-4": {
            "Meraki\\Http\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Meraki\\Http\\": "tests",
            "Project\\": "examples/"
        }
    },
    "scripts": {
        "lint": "psalm",
        "test": "phpunit",
        "format": "php-cs-fixer fix -vvv",
        "develop": [
            "Composer\\Config::disableProcessTimeout",
            "phpunit-watcher watch"
        ],
        "changelog": "conventional-changelog",
        "release": "conventional-changelog --commit",
        "release:patch": "conventional-changelog --patch --commit",
        "release:minor": "conventional-changelog --minor --commit",
        "release:major": "conventional-changelog --major --commit"
    },
    "config": {
        "allow-plugins": {
            "captainhook/plugin-composer": true
        }
    }
}
